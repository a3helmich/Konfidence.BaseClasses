<Project>
	<PropertyGroup>
		<Version>2026.4.1</Version>

		<Authors>Adrie Helmich</Authors>
		<Copyright>Konfidence in it 2026.</Copyright>
		<Company>Konfidence in it</Company>
		<AssemblyCompany>Konfidence in it</AssemblyCompany>

		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<TestTfmsInParallel>false</TestTfmsInParallel>

		<ComVisible>False</ComVisible>
		<CLSCompliant>False</CLSCompliant>
		<AssemblyCulture>en</AssemblyCulture>

		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

		<!--packaging-->
		<Product>Konfidence Base Classes</Product>

		<PackageTags>Konfidence;baseclasses</PackageTags>
		<Description>Konfidence helper classess for Konfidence tools and software</Description>

		<PackageOutputPath>$(SolutionDir)nuget</PackageOutputPath>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/a3helmich/Konfidence.BaseClasses</PackageProjectUrl>

		<RepositoryUrl>https://github.com/a3helmich/Konfidence.BaseClasses</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- The condition keeps local Debug builds from packaging. Note that the release build
		     pipeline depends on this being on for Release: its "dotnet tool install
		     ClientSettingsUpdater" step installs from the nuget folder (PackageOutputPath above),
		     which is only populated because building Release already packs. Removing or
		     narrowing this breaks that step, and with it the SQL tests needing the credentials
		     it writes - the later dotnet pack step writes elsewhere and does not fill it. -->
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>
</Project>
